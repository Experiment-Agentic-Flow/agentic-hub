{
  "name": "agent-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Central hub for incremental, per-repo-triggered RAG ingestion and autonomous coding agents (bugfix & general ticket implementation), triggered via Jira -> n8n -> GitHub repository_dispatch.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest:push": "node rag-ingestion/ingestOnPush.js",
    "agent:bugfix": "node agent-logic/bugfix-agent.js",
    "agent:general": "node agent-logic/general-agent.js"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@pinecone-database/pinecone": "^3.0.3",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "simple-git": "^3.27.0"
  }
}
