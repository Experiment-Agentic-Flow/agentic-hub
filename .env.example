# --- Coding-agent provider switch (this repo only - global, not per target repo) ---
# 'gemini' (default) or 'copilot'. See shared/config.js CODING_PROVIDER.
CODING_PROVIDER=gemini

# --- Google Gemini CLI (default LLM for knowledge ingestion + ticket-implementation agents) ---
# Install the `gemini` CLI globally: npm install -g @google/gemini-cli
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model alias used by agent-logic/copilotAgent.js's default (Gemini) coding agent - see
# https://geminicli.com/docs/cli/model for aliases (auto/pro/flash/flash-lite).
GEMINI_MODEL=pro
# Faster/cheaper model used only for knowledge ingestion (knowledge-ingestion/summarizer.js).
GEMINI_SUMMARY_MODEL=flash

# --- GitHub Copilot CLI (used for ticket-implementation agents only when CODING_PROVIDER=copilot) ---
# Install the `copilot` CLI globally: npm install -g @github/copilot
# Auth precedence: COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN.
# Use a (classic or fine-grained) PAT with the "Copilot Requests" permission enabled.
COPILOT_GITHUB_TOKEN=
# Model used when CODING_PROVIDER=copilot. Defaults to gpt-5.6-luna (avoids burning Claude Sonnet quota).
COPILOT_MODEL=gpt-5.6-luna
# Used only by the repo/project relevance-judgment prompts (agent-logic/repoDirectoryLookup.js,
# agent-logic/contextRetrieval.js) - cheap, no-tool text generation.
COPILOT_SUMMARY_MODEL=gpt-5.6-luna

# --- Pinecone (vector DB + hosted embeddings) ---
PINECONE_API_KEY=
PINECONE_INDEX=agentic-hub-knowledge
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# --- Knowledge ingestion tuning ---
# How many Nx projects to analyze/upsert in parallel during a monorepo full-baseline ingest.
KNOWLEDGE_INGEST_CONCURRENCY=6

# --- GitHub (org-level PAT with repo scope, used to checkout/commit/PR across the org) ---
ORG_GITHUB_PAT=

# --- Jira (used to post the PR link back onto the originating ticket) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# REST API version: 2 for Jira Server/Data Center (default - v3 doesn't exist there), 3 for Jira Cloud.
JIRA_API_VERSION=2

# --- Set by unified-agent-runner.yml when invoking agent-logic scripts ---
# TICKET_KEY=
# TICKET_DESCRIPTION=
# TARGET_BRANCH=
# WORKSPACE_DIR=
