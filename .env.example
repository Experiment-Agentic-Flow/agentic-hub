# --- GitHub Copilot CLI (LLM for summarization + coding agents) ---
# Install the `copilot` CLI globally: npm install -g @github/copilot
# Auth precedence: COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN.
# Use a (classic or fine-grained) PAT with the "Copilot Requests" permission enabled.
COPILOT_GITHUB_TOKEN=
# Model used by agent-logic/copilotAgent.js for bugfix & tech-debt implementation.
COPILOT_MODEL=claude-sonnet-5
# Lower-cost/faster model used only for RAG summarization (rag-ingestion/summarizer.js).
COPILOT_SUMMARY_MODEL=claude-haiku-4.5

# --- Pinecone (vector DB + hosted embeddings) ---
PINECONE_API_KEY=
PINECONE_INDEX=agentic-hub-knowledge
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# --- RAG ingestion tuning ---
# How many Nx projects to analyze/upsert in parallel during a monorepo full-baseline ingest.
RAG_INGEST_CONCURRENCY=6

# --- GitHub (org-level PAT with repo scope, used to checkout/commit/PR across the org) ---
ORG_GITHUB_PAT=

# --- Jira (used to post the PR link back onto the originating ticket) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# REST API version: 2 for Jira Server/Data Center (default - v3 doesn't exist there), 3 for Jira Cloud.
JIRA_API_VERSION=2

# --- Set by unified-agent-runner.yml when invoking agent-logic scripts ---
# TICKET_KEY=
# TICKET_DESCRIPTION=
# TARGET_BRANCH=
# WORKSPACE_DIR=
